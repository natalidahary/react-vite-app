{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "productexplorer",
  "projectType": "application",
  "sourceRoot": "apps/productexplorer/src",
  "tags": ["type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/productexplorer"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build --logLevel error",
        "cwd": "apps/productexplorer"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/productexplorer"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/productexplorer/src",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"Run npx playwright test for e2e coverage\"",
        "cwd": "."
      }
    }
  }
}
